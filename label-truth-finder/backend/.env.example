# Copy to .env (cp .env.example .env) and edit only if you need to.
HOST=127.0.0.1
PORT=5001
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
# Seconds to wait for the model (the first request after starting Ollama is slowest)
OLLAMA_TIMEOUT=240
MAX_IMAGE_MB=10
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Open Food Facts asks apps to identify themselves. Put your email or GitHub name.
OFF_CONTACT=your-email-or-github-name
# DATABASE_PATH=data/label_truth_finder.db
